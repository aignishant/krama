#!/usr/bin/env bash
# l — the Krama Languages daily driver.
set -euo pipefail
cd "$(dirname "$0")"

PY="python"

die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

day_dir() {  # day_dir N -> the day's folder, or empty
  local n="$1"
  find days -mindepth 1 -maxdepth 1 -type d -name "$(printf 'day-%03d-*' "$n")" | sort | head -1
}

usage() {
  cat <<'EOF'
usage: ./l <command> [args]

  status        progress on all three tracks, computed from disk
  day N         print day N's hub and list its files
  next          the first day that is not written yet
  check [N]     verify written lessons against the format contract
  build         create any missing day folders and placeholders, rebuild hubs and index

  write a day with:  /day-langs N
EOF
}

case "${1:-}" in
  status) $PY scripts/status.py ;;

  day)
    [ $# -ge 2 ] || die "usage: ./l day N"
    d=$(day_dir "$2")
    [ -n "$d" ] || die "day $2 has no folder — run ./l build"
    ${PAGER:-cat} "$d/README.md"
    printf '\n\033[32mfiles:\033[0m\n'
    find "$d" -maxdepth 1 -name '*.md' | sort
    ;;

  next) $PY scripts/status.py --next ;;

  check) shift; $PY scripts/check_day.py "$@" ;;

  build) $PY scripts/build_skeleton.py ;;

  -h|--help|help|"") usage ;;

  *) die "unknown command: $1 (try ./l help)" ;;
esac
